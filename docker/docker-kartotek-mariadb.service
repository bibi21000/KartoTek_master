[Unit]
Description=KartoTek MariaDB Docker Container
# Only start after Docker is ready
After=docker.service
Requires=docker.service
# Wait for network to be available
After=network-online.target

[Service]
Type=simple

# Environment files
EnvironmentFile=/etc/kartotek/systemd.conf
EnvironmentFile=/etc/kartotek/mariadb/systemd.conf

# Create the Docker volume if it doesn't exist
# ExecStartPre=/bin/bash -c '/usr/bin/docker volume inspect kartotek_mariadb >/dev/null 2>&1 || /usr/bin/docker volume create kartotek_mariadb'

# Pull the image first if PULL is true/True/1
ExecStartPre=/bin/bash -c 'if [ "$PULL" = "true" ] || [ "$PULL" = "1" ]; then exec /usr/bin/docker pull "$IMAGE"; fi; exit 0'

# Start the container in the foreground (no -d flag)
ExecStart=/usr/bin/docker run \
  --name kartotek_mariadb \
  --rm ${DOCKER_OPTS} \
  -v ${MOUNT}:/var/lib/mysql \
  -e MYSQL_ROOT_PASSWORD=${ROOT_PASSWORD} \
  -e MYSQL_DATABASE=${DATABASE} \
  -e MYSQL_USER=${USER} \
  -e MYSQL_PASSWORD=${PASSWORD} \
  ${IMAGE}

# Gracefully stop the container
ExecStop=/usr/bin/docker stop -t 30 kartotek_mariadb

# Timeout for start operation
TimeoutStartSec=60
# Timeout for stop operation
TimeoutStopSec=35

# Always restart on failure
Restart=always
RestartSec=45

[Install]
WantedBy=multi-user.target
