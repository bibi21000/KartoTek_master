[Unit]
Description=KartoTek Matomo Docker Container
# Only start after Docker is ready
After=docker.service
After=docker-kartotek-mariadb.service
Requires=docker.service
Requires=docker-kartotek-mariadb.service
# Wait for network to be available
After=network-online.target

[Service]
Type=simple

# Environment files
EnvironmentFile=/etc/kartotek/systemd.conf
EnvironmentFile=/etc/kartotek/mariadb/systemd.conf
EnvironmentFile=/etc/kartotek/matomo/systemd.conf

# Pull the image first if PULL is true/True/1
ExecStartPre=/bin/bash -c 'if [ "$PULL" = "true" ] || [ "$PULL" = "1" ]; then exec /usr/bin/docker pull "$IMAGE"; fi; exit 0'

# Start the container in the foreground (no -d flag)
ExecStart=/usr/bin/docker run \
  --name kartotek_matomo \
  --rm ${DOCKER_OPTS} \
  -p 8181:80 \
  -v ${MOUNT}:/var/www/html \
  -e MATOMO_DATABASE_HOST=${DATABASE_HOST} \
  -e MATOMO_DATABASE_DBNAME=${DATABASE} \
  -e MATOMO_DATABASE_USERNAME=${USER} \
  -e MATOMO_DATABASE_PASSWORD=${PASSWORD} \
  ${IMAGE}

# Gracefully stop the container
ExecStop=/usr/bin/docker stop -t 30 kartotek_matomo

# Timeout for start operation
TimeoutStartSec=60
# Timeout for stop operation
TimeoutStopSec=35

# Always restart on failure
Restart=always
RestartSec=45

[Install]
WantedBy=multi-user.target
